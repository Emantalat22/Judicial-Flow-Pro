# ==============================================================================
# Judicial Flow Pro — Environment Variable Template
# Copy this file to .env and fill in your actual values:
# cp .env.example .env
# ==============================================================================

# PostgreSQL Connection String
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/judicial_flow_pro

# Secret key used for JWT signing (generate with: openssl rand -hex 32)
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-or-longer

# Access token expiration in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: AI Assistant Provider & API Keys (leave empty to use local fallback mode)
AI_PROVIDER=groq
AI_MODEL_NAME=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL_NAME=llama-3.3-70b-versatile
# OPENAI_API_KEY=your-openai-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here

